<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      allowBackup is off because the only data worth backing up is sessions and saved
      sign-ins, and both are encrypted under a Keystore key that never leaves this phone: a
      restored copy could not be read anyway. Anything that does arrive by device transfer
      reads as "nothing saved" (SecretStore), and the person signs in again.

      The network security config allows plain http and ws, because a self-hosted server on
      a home network usually has no certificate. The page itself is still a secure context
      (http://localhost), which is what the microphone requires.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <!--
          configChanges lists everything the page can absorb itself. Without an entry Android
          destroys and recreates the activity — and with it the WebView and the call — on a
          rotation, a dark-mode switch or a font-size change.
        -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density|fontScale|layoutDirection"
            android:name=".MainActivity"
            android:label="${appLabel}"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Invite links: weave://join?server=…&code=… opens Register with the code filled in. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="weave" android:host="join" />
            </intent-filter>

        </activity>

        <!--
          The way a ringing call's notification opens the app (Answer, or a tap on the ring).
          Not exported, unlike MainActivity itself: no other app can open Weave on a call, and
          MainActivity only believes call extras that arrive through here.
        -->
        <activity-alias
            android:name=".CallEntry"
            android:targetActivity=".MainActivity"
            android:exported="false" />

        <!--
          Where a Weave server's pushes arrive, through the UnifiedPush distributor (ntfy or
          another) the person has installed: calls that ring with Weave closed. Not exported;
          the distributor reaches it through the UnifiedPush library's own exported parts.
        -->
        <service
            android:name=".WeavePushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>

        <!-- Decline, from a ringing call's notification. Only this app's notifications send it. -->
        <receiver
            android:name=".CallActionReceiver"
            android:exported="false" />

        <!--
          Voice that keeps going with the screen off (VoiceService). phoneCall is what a calling
          app holds on Android 14 and later; microphone keeps the microphone recording once
          the app is out of sight (Android 11+), which it otherwise would not. Not exported:
          only this app starts it.
        -->
        <service
            android:name=".VoiceService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|microphone" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Network events, so a reconnect starts when the phone changes networks. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Chromium sets the call audio mode (and with it echo cancellation) through this. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Voice in the background: the service, its types, and the locks it holds while a call
         lasts. MANAGE_OWN_CALLS is what lets a calling app register its calls with Android's
         call system (Telecom) and hold a phoneCall service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The call's controls live in a notification, which Android 13 asks about. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- An incoming call fills the screen over the lock screen, as a phone's own does. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- "Keep Weave running in the background" in Settings asks with this. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Asked for, never required: a phone without a camera can still talk. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
