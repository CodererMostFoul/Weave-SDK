<?xml version="1.0" encoding="utf-8"?>
<!--
  Drawn, not exported: a gradient ground and the strand, both XML (see drawable/). There are no
  bitmap fallbacks because nothing below Android 8 can install the app (minSdk 29), and the
  monochrome layer is what Android 13's themed icons tint.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background"/>
    <foreground android:drawable="@drawable/ic_launcher_foreground"/>
    <monochrome android:drawable="@drawable/ic_launcher_foreground"/>
</adaptive-icon>
