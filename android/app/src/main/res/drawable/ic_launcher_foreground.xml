<?xml version="1.0" encoding="utf-8"?>
<!--
  The strand: the same path as the brand mark in the app's own header (src/main.js), drawn
  rather than exported, so it is sharp at every launcher size and changes with one edit.

  The mark's 24-unit box is scaled by 3.1 and centred in the 108dp adaptive-icon canvas, so
  the strand is about 56dp wide and even its rounded ends stay inside the 66dp circle every
  launcher's mask keeps: no shape of mask can clip them.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="3.1"
        android:scaleY="3.1"
        android:translateX="16.8"
        android:translateY="16.8">
        <path
            android:pathData="M3,14c2.5,0 2.5,-4 5,-4s2.5,4 5,4 2.5,-4 5,-4 2.5,4 3,4"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="2.2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
